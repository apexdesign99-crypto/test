{
  "name": "bp-voice-tally",
  "version": "1.0.0",
  "description": "血圧を音声で記録して自動集計するアプリ（iOS / Android / ブラウザ）",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --dev && python3 -m http.server 8080 --directory www",
    "watch": "node build.mjs --watch",
    "test": "node --test test/*.test.js",
    "sync": "npm run build && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "preview:native": "npm run build && node tools/preview-native.mjs"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "esbuild": "^0.24.2"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^6.0.1",
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.3",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/local-notifications": "^6.1.2",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/share": "^6.0.3"
  }
}
