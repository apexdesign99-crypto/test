# Claude API キー (https://console.anthropic.com/ で発行)
ANTHROPIC_API_KEY=sk-ant-...

# 省略可 — 既定値は以下のとおり
# PORT=3000
# HOST=127.0.0.1
# VOICE_MODEL=claude-opus-5
# VOICE_EFFORT=low        # low | medium | high | xhigh | max
# VOICE_MAX_TOKENS=4096

# --- セキュリティ ---
# 設定するとログイン必須になる（ローカル以外に出すなら必ず設定する）
# VOICE_ACCESS_TOKEN=長いランダム文字列
# VOICE_ALLOWED_ORIGINS=https://voice.example.com   # 省略時は Host と一致する Origin のみ許可
# VOICE_TRUST_PROXY=1                # リバースプロキシ配下のときだけ 1
# VOICE_RATE_LIMIT_PER_MIN=20        # 会話リクエスト/分
# VOICE_LOGIN_RATE_LIMIT_PER_MIN=5   # ログイン試行/分
# VOICE_MAX_CONCURRENT_STREAMS=2     # 同時ストリーム数
# VOICE_SESSION_TTL_HOURS=12         # ログインの有効期間
# VOICE_ALLOW_INSECURE=1             # 認証なしで外部公開する（非推奨）
